{
  "name": "agent-manager-web",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "tsc --noEmit && prettier --check src public/*.js index.html vite.config.js",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write src public/*.js public/*.webmanifest index.html vite.config.js package.json tsconfig.json"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "8.3.5"
  }
}
